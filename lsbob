#!/bin/bash
set -euo pipefail

echo "Connected BoBs:"
echo "--------------------------------"

# Collect candidate symlinks (may include literal patterns if none exist)
all_symlinks=( /dev/rtHST* /dev/rtDBG* )

declare -A have   # keys like "2:HST:sdk" => 1
declare -A idxmap # keys like "2" => 1

for link in "${all_symlinks[@]}"; do
  [[ -e "$link" ]] || continue

  # Skip broken symlinks
  real_target=$(readlink -f "$link" 2>/dev/null || true)
  [[ -n "$real_target" && -e "$real_target" ]] || continue

  base=$(basename "$link")

  # Matches: rtHST<idx>-sdk|log, rtDBG<idx>-sdk|log
  if [[ "$base" =~ ^rt(HST|DBG)([0-9]+)-(sdk|log)$ ]]; then
    prefix="${BASH_REMATCH[1]}"  # HST or DBG
    idx="${BASH_REMATCH[2]}"     # digits
    role="${BASH_REMATCH[3]}"    # sdk or log

    have["$idx:$prefix:$role"]=1
    idxmap["$idx"]=1
  fi
done

if [[ ${#idxmap[@]} -eq 0 ]]; then
  echo "(none found)"
  exit 0
fi

for num in $(printf '%s\n' "${!idxmap[@]}" | sort -n); do
  out="BoB $num:"

  [[ ${have["$num:HST:sdk"]+x} ]] && out+=" [HST-sdk]"
  [[ ${have["$num:HST:log"]+x} ]] && out+=" [HST-log]"
  [[ ${have["$num:DBG:sdk"]+x} ]] && out+=" [DBG-sdk]"
  [[ ${have["$num:DBG:log"]+x} ]] && out+=" [DBG-log]"

  echo "$out"
done

echo "--------------------------------"

